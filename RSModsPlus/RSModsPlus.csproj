<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
	<PropertyGroup>
		<Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
		<Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
		<ProjectGuid>{C92F58F4-75B9-4AE0-A722-8F63833EE42C}</ProjectGuid>
		<OutputType>Library</OutputType>
		<TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
		<Deterministic>true</Deterministic>
		<AssemblyName>RocksmithAudioBridge</AssemblyName>
		<RootNamespace>RSModsPlus</RootNamespace>
		<PlatformTarget>x64</PlatformTarget>
		<LangVersion>7.3</LangVersion>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<!-- The FretNet model is resolved from RSMODSPLUS_TOOLS_DIR; /p:MlModelPath overrides it. -->
		<MlModelPath Condition="'$(MlModelPath)' == '' And '$(RSMODSPLUS_TOOLS_DIR)' != ''">$(RSMODSPLUS_TOOLS_DIR)\ml-training\models\fretnet_guitarset.onnx</MlModelPath>
		<!-- Bass arrangements run a bass-trained FretNet (same input/output contract; string slots
		     0..3 = E1 A1 D2 G2). /p:MlBassModelPath overrides it. -->
		<MlBassModelPath Condition="'$(MlBassModelPath)' == '' And '$(RSMODSPLUS_TOOLS_DIR)' != ''">$(RSMODSPLUS_TOOLS_DIR)\ml-training\models\fretnet_bass_scale.onnx</MlBassModelPath>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Numerics" />
		<Compile Include="MachineLearning\ChartExpectationReader.cs" />
		<Compile Include="MachineLearning\NoteEvidence.cs" />
		<Compile Include="MachineLearning\MlService.cs" />
		<Compile Include="MachineLearning\MlServiceConnection.cs" />
		<Compile Include="MachineLearning\CqtTransform.cs" />
		<Compile Include="MachineLearning\SampleRateConverter.cs" />
		<EmbeddedResource Include="MachineLearning\CqtBasis.bin" LogicalName="RSModsPlus.MachineLearning.CqtBasis.bin" />
		<Content Include="Native\bin\soxr.dll">
			<Link>soxr.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Native\soxr\COPYING.LGPL">
			<Link>ThirdParty\soxr\COPYING.LGPL</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Native\soxr\LICENCE">
			<Link>ThirdParty\soxr\LICENCE</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Compile Include="MachineLearning\EmbeddedModel.cs" />
		<Compile Include="MachineLearning\FretNetSession.cs" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
		<EmbeddedResource Include="$(MlModelPath)" LogicalName="RSModsPlus.MachineLearning.FretNet.onnx" />
		<EmbeddedResource Include="$(MlBassModelPath)" LogicalName="RSModsPlus.MachineLearning.FretNetBass.onnx" />
	</ItemGroup>
	<Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
	<Target Name="BuildNativeResampler" BeforeTargets="PrepareForBuild">
		<Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\BuildNative.ps1&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\Native\bin&quot;" />
	</Target>
	<Target Name="ValidateMlModel" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(MlModelPath)')" Text="FretNet model missing. Set RSMODSPLUS_TOOLS_DIR to the folder that holds ml-training\models, or pass /p:MlModelPath=absolute-path. The model must be embedded; no external model is loaded at runtime." />
		<Error Condition="!Exists('$(MlBassModelPath)')" Text="Bass FretNet model missing. Set RSMODSPLUS_TOOLS_DIR to the folder that holds ml-training\models, or pass /p:MlBassModelPath=absolute-path." />
	</Target>
</Project>
