<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RocksmithAudioBridge.App.App"
             RequestedThemeVariant="Dark">

  <!--
    The look of the in-game overlay (Mod/Shell/OverlayUi.hpp, namespace Color): keep these in step with it.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="WindowColor">#0B111E</Color>
      <Color x:Key="HeaderColor">#0E1526</Color>
      <Color x:Key="CardColor">#151E32</Color>
      <Color x:Key="CardEdgeColor">#222E48</Color>
      <Color x:Key="HoverColor">#1E2A42</Color>
      <Color x:Key="TrackColor">#24304A</Color>
      <Color x:Key="TextColor">#E6EAF2</Color>
      <Color x:Key="MutedColor">#8A97AD</Color>
      <Color x:Key="FaintColor">#5B6880</Color>
      <Color x:Key="AccentColor">#3B8BEB</Color>
      <Color x:Key="AccentHiColor">#60A5FA</Color>
      <Color x:Key="AccentSoftColor">#3C3B8BEB</Color>
      <Color x:Key="GoodColor">#34D399</Color>
      <Color x:Key="WarnColor">#FBBF24</Color>
      <Color x:Key="BadColor">#F87171</Color>

      <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
      <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource HeaderColor}" />
      <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
      <SolidColorBrush x:Key="CardEdgeBrush" Color="{StaticResource CardEdgeColor}" />
      <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
      <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
      <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
      <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
      <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />

      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#3B8BEB"
                               AltHigh="#0B111E"
                               RegionColor="#0B111E"
                               BaseHigh="#E6EAF2"
                               ChromeMediumLow="#151E32"
                               ChromeMedium="#1E2A42"
                               ChromeLow="#0E1526"
                               ChromeAltLow="#E6EAF2"
                               ListLow="#1E2A42"
                               ListMedium="#24304A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://RocksmithAudioBridge/Styles/Overlay.axaml" />
  </Application.Styles>
</Application>
