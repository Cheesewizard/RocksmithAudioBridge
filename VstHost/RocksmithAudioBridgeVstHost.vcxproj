  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Into the game root after every build, next to the 64-bit bridge driver (shared DeployToGame.targets). -->
  <!-- The Stompbox engine (Stompbox\UPSTREAM.md), built separately by Stompbox\Build-Stompbox.ps1. The host runs
       without it (the VST chain plays); with it, StompboxDev can route the stream through it. -->
  <PropertyGroup>
    <StompboxDll>$(ProjectDir)Stompbox\bin\stompbox-capi.dll</StompboxDll>
  </PropertyGroup>
  <Target Name="CopyStompboxEngine" AfterTargets="Build" Condition="Exists('$(StompboxDll)')">
    <Copy SourceFiles="$(StompboxDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CollectGameDeployFiles" BeforeTargets="DeployToGame">
    <ItemGroup>
      <GameDeployFile Include="$(TargetPath)" Destination="$(RocksmithInstallDir)\$(TargetName)$(TargetExt)" />
      <GameDeployFile Include="$(StompboxDll)" Destination="$(RocksmithInstallDir)\stompbox-capi.dll" Condition="Exists('$(StompboxDll)')" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\DeployToGame.targets" />
</Project>
