<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5D3E8A41-7C2B-4F69-B1E0-9A4C6D2F8E17}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>RocksmithAudioBridgeVstHost</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- 64-bit only: it hosts 64-bit VST3 plugins outside the 32-bit game and reaches the game through the
       64-bit bridge driver (external amp link). Ships next to RocksmithAudioBridgeAsio64.dll. -->
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>RocksmithAudioBridgeVstHost</TargetName>
    <OutDir>$(ProjectDir)..\Installer\Resources\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\build\VstHost\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(ProjectDir)Lib\JUCE\modules;$(ProjectDir)Lib\JUCE\modules\juce_audio_processors_headless\format_types\VST3_SDK;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WINDOWS;UNICODE;_UNICODE;NOMINMAX;_CRT_SECURE_NO_WARNINGS;JUCE_GLOBAL_MODULE_SETTINGS_INCLUDED=1;JUCE_STANDALONE_APPLICATION=1;JUCE_PLUGINHOST_VST3=1;JUCE_VST3_HOST_CROSS_PLATFORM_UID=1;JUCE_USE_CURL=0;JUCE_WEB_BROWSER=0;JUCE_DISPLAY_SPLASH_SCREEN=0;JUCE_REPORT_APP_USAGE=0;JUCE_MODULE_AVAILABLE_juce_core=1;JUCE_MODULE_AVAILABLE_juce_events=1;JUCE_MODULE_AVAILABLE_juce_data_structures=1;JUCE_MODULE_AVAILABLE_juce_graphics=1;JUCE_MODULE_AVAILABLE_juce_gui_basics=1;JUCE_MODULE_AVAILABLE_juce_gui_extra=1;JUCE_MODULE_AVAILABLE_juce_audio_basics=1;JUCE_MODULE_AVAILABLE_juce_audio_processors_headless=1;JUCE_MODULE_AVAILABLE_juce_audio_processors=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- JUCE: big translation units (one per module), sources in UTF-8, and the real __cplusplus. -->
      <AdditionalOptions>/bigobj /utf-8 /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">DEVELOPMENT=1;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'!='Debug'">RELEASE=1;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'!='Debug'">MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'!='Debug'">MaxSpeed</Optimization>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>ole32.lib;shell32.lib;comdlg32.lib;advapi32.lib;user32.lib;dbghelp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\Main.cpp" />
    <ClCompile Include="Source\BridgeAudio.cpp" />
    <ClCompile Include="Source\PluginHost.cpp" />
    <ClCompile Include="Source\Chain.cpp" />
    <ClCompile Include="Source\HostLog.cpp" />
    <ClCompile Include="Source\SourceRouter.cpp" />
    <ClCompile Include="Source\StompboxEngine.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Source\BridgeAudio.hpp" />
    <ClInclude Include="Source\PluginHost.hpp" />
    <ClInclude Include="Source\Chain.hpp" />
    <ClInclude Include="Source\HostLog.hpp" />
    <ClInclude Include="Source\SourceRouter.hpp" />
    <ClInclude Include="Source\StompboxEngine.hpp" />
    <ClInclude Include="Source\AudioFormat.hpp" />
  </ItemGroup>
  <!-- JUCE 9 (Lib\JUCE, AGPLv3: Lib\JUCE\LICENSE.txt; this program is AGPLv3 because of it, see LICENSE.txt
       next to this project). One translation unit per module; its own VST3 SDK copy is used, so the
       standalone Lib\vst3sdk is gone. -->
  <ItemGroup>
