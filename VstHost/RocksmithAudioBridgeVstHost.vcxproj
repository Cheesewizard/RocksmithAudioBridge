<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5D3E8A41-7C2B-4F69-B1E0-9A4C6D2F8E17}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>RocksmithAudioBridgeVstHost</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <!-- 64-bit only: it hosts 64-bit VST3 plugins outside the 32-bit game and reaches the game through the
       64-bit bridge driver (external amp link). Ships next to RocksmithAudioBridgeAsio64.dll. -->
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>RocksmithAudioBridgeVstHost</TargetName>
    <OutDir>$(ProjectDir)..\Installer\Resources\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)..\build\VstHost\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(ProjectDir)Lib\vst3sdk;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WINDOWS;UNICODE;_UNICODE;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">DEVELOPMENT=1;_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'!='Debug'">RELEASE=1;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'!='Debug'">MultiThreaded</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'!='Debug'">MaxSpeed</Optimization>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>ole32.lib;shell32.lib;comdlg32.lib;advapi32.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\Main.cpp" />
    <ClCompile Include="Source\BridgeAudio.cpp" />
    <ClCompile Include="Source\PluginHost.cpp" />
    <ClCompile Include="Source\Chain.cpp" />
    <ClCompile Include="Source\HostLog.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Source\BridgeAudio.hpp" />
    <ClInclude Include="Source\PluginHost.hpp" />
    <ClInclude Include="Source\Chain.hpp" />
    <ClInclude Include="Source\HostLog.hpp" />
  </ItemGroup>
  <!-- The part of Steinberg's VST3 SDK (MIT, Lib\vst3sdk\LICENSE.txt) a host needs: the interfaces plus the
       hosting helpers. No VSTGUI, no base library. -->
  <ItemGroup>
    <ClCompile Include="Lib\vst3sdk\pluginterfaces\base\conststringtable.cpp" />
    <ClCompile Include="Lib\vst3sdk\pluginterfaces\base\coreiids.cpp" />
    <ClCompile Include="Lib\vst3sdk\pluginterfaces\base\funknown.cpp" />
    <ClCompile Include="Lib\vst3sdk\pluginterfaces\base\ustring.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\common\commoniids.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\vstinitiids.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\common\commonstringconvert.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\common\memorystream.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\common\threadchecker_win32.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\connectionproxy.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\eventlist.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\hostclasses.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\module.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\module_win32.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\parameterchanges.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\pluginterfacesupport.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\plugprovider.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\hosting\processdata.cpp" />
    <ClCompile Include="Lib\vst3sdk\public.sdk\source\vst\utility\stringconvert.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Into the game root after every build, next to the 64-bit bridge driver (shared DeployToGame.targets). -->
  <Target Name="CollectGameDeployFiles" BeforeTargets="DeployToGame">
    <ItemGroup>
      <GameDeployFile Include="$(TargetPath)" Destination="$(RocksmithInstallDir)\$(TargetName)$(TargetExt)" />
    </ItemGroup>
  </Target>
  <Import Project="$(MSBuildThisFileDirectory)..\DeployToGame.targets" />
</Project>
