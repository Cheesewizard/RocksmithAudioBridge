    <ClCompile Include="Lib\JUCE\modules\juce_graphics\juce_graphics_libwebp_dsp_dec.c" />
    <ClCompile Include="Lib\JUCE\modules\juce_graphics\juce_graphics_libwebp_dsp_dec_avx2.c" />
