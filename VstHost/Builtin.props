<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Lib\NeuralAmpModelerCore;$(MSBuildThisFileDirectory)Lib\NeuralAmpModelerCore\Dependencies\eigen;$(MSBuildThisFileDirectory)Lib\NeuralAmpModelerCore\Dependencies\nlohmann;$(MSBuildThisFileDirectory)Lib\airwin2rack\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NAM_SAMPLE_FLOAT;NAM_ENABLE_A2_FAST;_USE_MATH_DEFINES;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ExceptionHandling>Sync</ExceptionHandling>
    </ClCompile>
    <Link><AdditionalDependencies>bcrypt.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)Source\Builtin\*.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)Source\Builtin\*.hpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Lib\NeuralAmpModelerCore\NAM\*.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Lib\NeuralAmpModelerCore\NAM\wavenet\*.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Lib\airwin2rack\src\AirwinRegistry.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Lib\airwin2rack\src\airwin_consolidated_base.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)Lib\airwin2rack\src\autogen_airwin\*.cpp" />
  </ItemGroup>
</Project>
